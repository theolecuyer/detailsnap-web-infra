#!/bin/bash
aws eks update-kubeconfig --name ${cluster_name} --region us-east-1 || true

# Stop the LBC controller so it can't hold or recreate SGs while we clean up
kubectl scale deployment aws-load-balancer-controller -n kube-system --replicas=0 2>/dev/null || true
sleep 30

for arn in $(aws elbv2 describe-load-balancers --region us-east-1 \
  --query 'LoadBalancers[*].LoadBalancerArn' --output text); do
  aws elbv2 delete-load-balancer --load-balancer-arn "$arn" --region us-east-1 || true
done

echo "Waiting for ALB ENIs to be released..."
for i in $(seq 1 36); do
  eni_count=$(aws ec2 describe-network-interfaces --region us-east-1 \
    --filters "Name=vpc-id,Values=${vpc_id}" "Name=description,Values=*ELB*" \
    --query 'length(NetworkInterfaces)' --output text)
  [ "$eni_count" = "0" ] && break
  echo "  $eni_count ENI(s) still attached, waiting 10s..."
  sleep 10
done

for tg in $(aws elbv2 describe-target-groups --region us-east-1 \
  --query 'TargetGroups[?starts_with(TargetGroupName, `k8s-`)].TargetGroupArn' --output text); do
  aws elbv2 delete-target-group --target-group-arn "$tg" --region us-east-1 || true
done

# Get the default SG to use as fallback when detaching k8s SGs from ENIs
# (AWS requires at least 1 SG per ENI, so we can't set an empty list)
default_sg=$(aws ec2 describe-security-groups --region us-east-1 \
  --filters "Name=vpc-id,Values=${vpc_id}" "Name=group-name,Values=default" \
  --query 'SecurityGroups[0].GroupId' --output text)

echo "Detaching k8s SGs from node ENIs..."
for sg in $(aws ec2 describe-security-groups --region us-east-1 \
  --filters "Name=vpc-id,Values=${vpc_id}" \
  --query 'SecurityGroups[?starts_with(GroupName, `k8s-`)].GroupId' --output text); do
  for eni in $(aws ec2 describe-network-interfaces --region us-east-1 \
    --filters "Name=group-id,Values=$sg" "Name=vpc-id,Values=${vpc_id}" \
    --query 'NetworkInterfaces[*].NetworkInterfaceId' --output text); do
    new_sgs=$(aws ec2 describe-network-interfaces --network-interface-ids "$eni" --region us-east-1 \
      --query "NetworkInterfaces[0].Groups[?GroupId!='$sg'].GroupId" --output text)
    # Fall back to default SG if this was the only SG on the ENI
    aws ec2 modify-network-interface-attribute --network-interface-id "$eni" \
      --groups $${new_sgs:-$default_sg} --region us-east-1 2>/dev/null || true
  done
done

# Revoke all rules from every non-default SG in the VPC to break circular references.
# Targets k8s-* and eks-cluster-sg-* (EKS auto-created, not in Terraform state).
echo "Revoking rules from non-default security groups..."
for sg in $(aws ec2 describe-security-groups --region us-east-1 \
  --filters "Name=vpc-id,Values=${vpc_id}" \
  --query 'SecurityGroups[?GroupName!=`default`].GroupId' --output text); do
  ingress=$(aws ec2 describe-security-groups --group-ids "$sg" --region us-east-1 \
    --query 'SecurityGroups[0].IpPermissions' --output json 2>/dev/null || echo "[]")
  egress=$(aws ec2 describe-security-groups --group-ids "$sg" --region us-east-1 \
    --query 'SecurityGroups[0].IpPermissionsEgress' --output json 2>/dev/null || echo "[]")
  if [ "$ingress" != "[]" ] && [ "$ingress" != "null" ] && [ -n "$ingress" ]; then
    aws ec2 revoke-security-group-ingress --group-id "$sg" \
      --ip-permissions "$ingress" --region us-east-1 2>/dev/null || true
  fi
  if [ "$egress" != "[]" ] && [ "$egress" != "null" ] && [ -n "$egress" ]; then
    aws ec2 revoke-security-group-egress --group-id "$sg" \
      --ip-permissions "$egress" --region us-east-1 2>/dev/null || true
  fi
done

# Delete all non-default SGs with retries — covers k8s-* and eks-cluster-sg-*
# that exist outside Terraform state and would otherwise block VPC deletion.
echo "Deleting non-default security groups..."
for attempt in $(seq 1 12); do
  remaining=0
  for sg in $(aws ec2 describe-security-groups --region us-east-1 \
    --filters "Name=vpc-id,Values=${vpc_id}" \
    --query 'SecurityGroups[?GroupName!=`default`].GroupId' --output text); do
    aws ec2 delete-security-group --group-id "$sg" --region us-east-1 2>/dev/null || remaining=$((remaining+1))
  done
  [ "$remaining" = "0" ] && break
  echo "  $remaining SG(s) still in use, waiting 15s..."
  sleep 15
done
